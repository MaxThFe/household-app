# Database configuration
HT_DATABASE_PATH=data/ourhome.db

# Sensor history, kept in its own file so the raw rows stay separate
HT_TIMESERIES_PATH=data/sensors.db
# A window opening is a break in the slope: the temperature falls this many °C
# more over 20 minutes than it did over the 20 minutes before them
HT_WINDOW_OPEN_DROP_C=0.6

# User names displayed in the app
HT_USER1_NAME=User1
HT_USER2_NAME=User2

# ICS calendar sync (optional)
# Work shifts — titles are rewritten to Early/Late/Night shift or Day off
HT_ICS_URL=
# General calendar — events keep their own titles and times
HT_ICS_GENERAL_URL=
# Work calendar — only events running past 17:00, and whole days that are not a deadline
HT_ICS_WORK_URL=
HT_ICS_SYNC_INTERVAL_MINUTES=30
