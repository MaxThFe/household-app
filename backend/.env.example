# Database configuration
HT_DATABASE_PATH=data/ourhome.db

# Sensor history, kept in its own file so the raw rows stay separate
HT_TIMESERIES_PATH=data/sensors.db

# User names displayed in the app
HT_USER1_NAME=User1
HT_USER2_NAME=User2

# ICS calendar sync (optional)
# Work shifts — titles are rewritten to Early/Late/Night shift or Day off
HT_ICS_URL=
# General calendar — events keep their own titles and times
HT_ICS_GENERAL_URL=
# Work calendar — only events running past 17:00, and whole days that are not a deadline
HT_ICS_WORK_URL=
# Comma-separated title fragments to leave out of the work calendar, e.g. Patch-Thursday
HT_ICS_WORK_IGNORE=
HT_ICS_SYNC_INTERVAL_MINUTES=30

# Shelly BLU TRV radiator valves (optional), through a Shelly BLU Gateway Gen3.
# The host is the gateway's LAN address; each valve's MAC is its Bluetooth address
# (shown as "addr" by http://<gateway>/rpc/Shelly.GetComponents)
HT_SHELLY_GATEWAY_HOST=
HT_TRV_LIVING_ROOM_MAC=
HT_TRV_BEDROOM_MAC=
HT_TRV_KITCHEN_MAC=

# Picnic ordering (optional), one account per user — run `python picnic_setup.py` once
# per user to log in. An order goes to the cart of whoever places it.
HT_PICNIC_USER1_EMAIL=
HT_PICNIC_USER1_PASSWORD=
HT_PICNIC_USER2_EMAIL=
HT_PICNIC_USER2_PASSWORD=
HT_PICNIC_COUNTRY_CODE=NL
# OpenAI maps shopping items to Picnic products (once per item, then cached)
HT_OPENAI_API_KEY=
HT_OPENAI_MODEL=gpt-6-luna
